%% This implementation mostly follows Regular Expression Matching Can Be Simple And Fast
%% (but is slow in Java, Perl, PHP, Python, Ruby, ...) by Russ Cox
%% https://swtch.com/~rsc/regexp/regexp1.html
%% The matching algorithm defined here is non-capturing, i.e., it matches longest/shortest substring
%% that is recognized by a given regular expression from a given initial position. The longest substring
%% is the greedy match and the shortest is the non-greedy one.

regex : THEORY
BEGIN

  IMPORTING regex_def

  FinalState : nat = 0

  connect_parent_initial(ndfa:NDFA,parent:Arrow,initial:nat)
    : [NDFA,list[Arrow]] =
    IF initial = FinalState THEN
      (ndfa,(: parent :))
    ELSE
        LET arrow    = mk_arrow(initial) <| set_label(parent`label),
	    new_ndfa = ndfa <| add_arrow(parent`state,arrow) IN
  	(new_ndfa,null)
    ENDIF

  connect_parent_initials(ndfa:NDFA,parent:Arrow,initials:list[nat])
    : RECURSIVE [NDFA,list[Arrow]] =
    IF null?(initials) THEN
      (ndfa,null)
    ELSE
      LET initial = car(initials),
          (new_ndfa1,new_parents1)
	          = connect_parent_initial(ndfa,parent,initial),
	  (new_ndfa2,new_parents2)
	          = connect_parent_initials(new_ndfa1,parent,cdr(initials)) IN
        (new_ndfa2,union_sl(new_parents1,new_parents2))
    ENDIF
    MEASURE initials BY <<
	 
  %% Add parents -> initials to ndfa
  connect_parents_initials(ndfa:NDFA,parents:list[Arrow],initials:list[nat])
    : RECURSIVE [NDFA,list[Arrow]] =
    IF null?(parents) THEN
      (ndfa,parents)
    ELSE
      LET parent = car(parents),
          (new_ndfa1,new_parents1)
	         = connect_parent_initials(ndfa,parent,initials),
          (new_ndfa2,new_parents2)
	         = connect_parents_initials(new_ndfa1,cdr(parents),initials) IN
  	(new_ndfa2,union_sl(new_parents1,new_parents2))
    ENDIF
  MEASURE parents BY <<

  build_initials(initials1,initials2:list[nat]) : list[nat] =
    IF member(FinalState,initials1) THEN
      union_sl(remove_sl(FinalState,initials1),initials2)
    ELSE initials1
    ENDIF

  CompiledRegext_ : TYPE = [#
    ndfa : NDFA,
    dangling_parents  : list[Arrow], % Node index, Guard index
    dangling_initials : list[nat]    % Node index
  #]

  % Build a CompiledRegext_ with multiple initials, one final, and no empty labels
  compilext_(re:Regex,ndfa:NDFA) : RECURSIVE CompiledRegext_ =
    CASES re OF
      Empty :
  	(#
  	  ndfa := ndfa,
  	  dangling_parents := null,
  	  dangling_initials := (: FinalState :)
        #),
      Accept(guard) :
        LET new_state = size(ndfa),
  	    new_label = length(ndfa`guards),
	    new_arrow = mk_arrow(new_state) <| set_label(new_label),
	    new_ndfa  = ndfa <| add_new_state <| add_new_guard(guard) IN
	  (#
  	     ndfa := new_ndfa,
  	     dangling_parents := (: new_arrow :),
  	     dangling_initials := (: new_state :)
  	  #),
      Union(re1,re2) :
        LET rgxt1 = compilext_(re1,ndfa),
  	    rgxt2 = compilext_(re2,rgxt1`ndfa) IN
  	  rgxt2 WITH [ `dangling_parents := union_sl(rgxt1`dangling_parents,
  	                                             rgxt2`dangling_parents),
  	  	       `dangling_initials := union_sl(rgxt1`dangling_initials,
  			                              rgxt2`dangling_initials)
  	             ],
      Seq(re1,re2) :
        LET rgxt1  = compilext_(re1,ndfa),
            rgxt2  = compilext_(re2,rgxt1`ndfa),
            (new_ndfa,new_parents) = connect_parents_initials(rgxt2`ndfa,
      	                                rgxt1`dangling_parents,
       	    				rgxt2`dangling_initials),
  	    new_initials = build_initials(rgxt1`dangling_initials,rgxt2`dangling_initials) IN
          rgxt1 WITH [ `ndfa := new_ndfa,
       		       `dangling_parents := union_sl(rgxt2`dangling_parents,new_parents),
       	  	       `dangling_initials := new_initials
  		     ],
      Plus(re) :
         LET rgxt = compilext_(re,ndfa),
            (new_ndfa,new_parents) = connect_parents_initials(rgxt`ndfa,
      	                                rgxt`dangling_parents,
       					add_sl(FinalState,rgxt`dangling_initials)) IN
          rgxt WITH [ `ndfa := new_ndfa,
       		      `dangling_parents := new_parents,
       	  	      `dangling_initials := rgxt`dangling_initials
  		    ]
    ENDCASES
  MEASURE re BY <<

  init_regex_ : NDFA =
    empty_ndfa <| add_new_state <| set_final(FinalState)

  compilext(re:Regex) : CompiledRegext_ =
    compilext_(re,init_regex_)

  add_dangling_parents(ndfa:NDFA,parents:list[Arrow]) : RECURSIVE NDFA =
    IF null?(parents) THEN ndfa
    ELSE
      LET parent = car(parents),
          new_arrow = mk_arrow(FinalState) <| set_label(parent`label),
          new_ndfa = ndfa <| add_arrow(parent`state,new_arrow) IN
        add_dangling_parents(new_ndfa,cdr(parents))
    ENDIF
  MEASURE parents BY <<

  add_dangling_initials(ndfa:NDFA,initials:list[nat]) : RECURSIVE NDFA =
    IF null?(initials) THEN ndfa
    ELSE
      LET new_ndfa = ndfa <| set_initial(car(initials)) IN
         add_dangling_initials(new_ndfa,cdr(initials))
    ENDIF
  MEASURE initials BY <<

  CompiledRegex : TYPE = PVSioValue[[#
    ndfa : NDFA,
    greedy :bool
  #]]

  % By default, compile to greedy
  compile(re:Regex) : CompiledRegex =
    LET rgxt = compilext(re),
        ndfa = add_dangling_parents(rgxt`ndfa,rgxt`dangling_parents),
  	new_ndfa = add_dangling_initials(ndfa,rgxt`dangling_initials) IN
      (# ndfa := new_ndfa, greedy := TRUE #)

  set_greediness(greedy:bool)(rgx:CompiledRegex) : CompiledRegex =
    rgx WITH [ `greedy := greedy ]

  ;<|(rgx:CompiledRegex,f:[CompiledRegex->CompiledRegex]) : CompiledRegex =
    f(rgx)

  Position : TYPE = [#
    nxt_pos : nat,           % Next position
    num_lin : upto(nxt_pos), % Number of LF characters (useful to report line number)
    pos_lin : upto(nxt_pos)  % Position of last LF character (useful to report column number)
  #]

  init_pos: Position = (#
    nxt_pos := 0,
    num_lin := 0,
    pos_lin := 0
  #)

  valid_pos?(pn:nat)(pos:Position) : MACRO bool =
    pos`nxt_pos <= pn

  next_pos(pos:Position,c:char) : {new_pos:Position | new_pos`nxt_pos = pos`nxt_pos+1} =
    LET nl      = (c=char_newline),
        new_pos = pos WITH [
          `nxt_pos := pos`nxt_pos+1
	] IN
    IF nl THEN new_pos WITH [
      num_lin := new_pos`num_lin+1,
      pos_lin := new_pos`nxt_pos
    ] ELSE
      new_pos
    ENDIF

  % If success is TRUE then matching succeded with substring [init_pos..nxt_pos).
  % Otherwise, matching failed and nxt_pos delimits the substring with maximum progress
  MatchResult_ : TYPE = [#
    success : boolean,
    pos     : Position
  #]

  mk_result(success:boolean,pos:Position) : MatchResult_ = (#
    success := success,
    pos    := pos
  #)

  MatchSuccess(pos:Position) : MatchResult_ =
    mk_result(TRUE,pos)

  MatchFailure(pos:Position) : MatchResult_ =
    mk_result(FALSE,pos)

  valid_result?(pn:nat)(result:MatchResult_) : MACRO bool =
    valid_pos?(pn)(pos(result))

  MatchResult(pn:nat) : TYPE = (valid_result?(pn))

  % Return position of the longest/shortest substring of str (starting at p) that matches rgx.
  match_pos_(rgx:CompiledRegex,               % Regular expression
             str:string,                      % String to check
             pos:(valid_pos?(length(str))), % Next position to check
             states:list[nat],                % Current initial states
	     matched_pos: Maybe[(valid_pos?(length(str)))]) % Current successful matching position
    : RECURSIVE MatchResult(length(str)) =
    IF pos`nxt_pos=length(str) THEN
      IF some?(matched_pos) THEN MatchSuccess(val(matched_pos))
      ELSE MatchFailure(pos) ENDIF
    ELSE 
      LET  next_char   = get(str,pos`nxt_pos),
           next_states = next(rgx`ndfa,states)(next_char) IN
        IF null?(next_states) THEN
	  IF some?(matched_pos) THEN MatchSuccess(val(matched_pos))
	  ELSE MatchFailure(pos) ENDIF
	ELSE
	  LET success  = member(FinalState,next_states),
	      next_pos = next_pos(pos,next_char) IN
	  IF NOT greedy(rgx) AND success THEN
	    MatchSuccess(next_pos)
	  ELSE
	    match_pos_(rgx,str,next_pos,next_states,
	               IF success THEN Some(next_pos) ELSE matched_pos ENDIF)
	  ENDIF
	ENDIF
    ENDIF
    MEASURE length(str)-pos`nxt_pos

  % Return MatchSucesso with the position of the longest/shortest substring of str (starting at pos0)
  % that is recognized by regex. Longest/shortest depends on wether the regex is set to be greedy
  % (longest) or non-greedy (shortest).
  % If no substring starting from pos0 matches regex, return a MatchFailure and the position of the
  % substring starting at pos0 that made the most progress.
  match_pos(rgx:CompiledRegex,str:string,pos0:(valid_pos?(length(str))))
    : MatchResult(length(str)) =
    LET init_states  = rgx`ndfa`initials ,
        init_matched = IF member(FinalState,init_states) THEN
	                 Some(pos0)
		       ELSE
		         None
		       ENDIF IN
    match_pos_(rgx,str,pos0,init_states,init_matched)

  match_pos(rgx:CompiledRegex,str:string) : MatchResult(length(str)) =
    match_pos(rgx,str,init_pos)

  % Return prefix and postfix of string, such that prefix is the longest/shortest prefix
  % of given string that is recognized by the regex. Longest/shortest depends on wether the
  % regex is set to be greedy (longest) or non-greedy (shortest).
  % Return None if no prefix matches regex
  match(rgx:CompiledRegex,str:string) : Maybe[[string,string]] =
    LET mpos = match_pos(rgx,str) IN
    IF mpos`success THEN
        LET prefx = gen_strings.substr(str,0,mpos`pos`nxt_pos),
	    posfx = gen_strings.substr(str,mpos`pos`nxt_pos,length(str)) IN
        (prefx,posfx)
    ELSE
      None
    ENDIF

  % Return prefix and postfix of string, such that prefix is the longest prefix
  % of given string that is recognized by the regex.
  % Return None if no prefix matches regex.
  greedy_match(rgx:CompiledRegex,str:string) : Maybe[[string,string]] =
    match(set_greediness(TRUE)(rgx),str)

  % Return prefix and postfix of string, such that prefix is the shortest prefix
  % of given string that is recognized by the regex.
  % Return None if no prefix matches regex.
  nongreedy_match(rgx:CompiledRegex,str:string) : Maybe[[string,string]] =
    match(set_greediness(FALSE)(rgx),str)

  CONVERSION compile

END regex

