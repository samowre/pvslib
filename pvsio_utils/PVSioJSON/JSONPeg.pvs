JSONPeg : THEORY
BEGIN

  IMPORTING json_def,
            PVSioPEG@pvsio_peg[JValue]

  mk_jbool : ASTBuilder =
    ast_try(ast_literal("true"),
            ast_this(JBool(TRUE)),
	    ast_this(JBool(FALSE)))

  str2jnum(str:string) : JValue =
    JNum(str2real(str))

  mk_str : ASTBuilder =
    ast_new(LAMBDA(quoted_str:string):
      IF length(quoted_str) >= 2 THEN
        JStr(gen_strings.substr(quoted_str,1,length(quoted_str)-1))
      ELSE
        NoAST
      ENDIF)

  add_jvalue(jarr,jval:JValue) : ASTOutput =
   IF jarray?(jarr) THEN
     JArray(snoc(jarray(jarr),jval))
   ELSE
      NoAST
   ENDIF

  mk_jarray : ASTBuilder =
    ast_this(JArray(null)) +
    ast_repeat(ast_make(add_jvalue))

  add_jobj(token_item:TokenItem)(jobj,jval:JValue) : ASTOutput =
   LET quoted_key = get_token(token_item) IN
   IF length(quoted_key) >= 2 AND jobject?(jobj) THEN
     LET key = gen_strings.substr(quoted_key,1,length(quoted_key)-1),
         jv  = jobject_field_value(jobj)(key) IN
     IF none?(jv) THEN
       JObject(snoc(jobject(jobj),(key,jval)))
     ELSE
       Exit("Key already exists",get_loc(token_item))
     ENDIF
   ELSE
      NoAST
   ENDIF

  mk_jobject : ASTBuilder =
    ast_this(JObject(null)) +
    ast_repeat(
      ast_consume + % Don't process the field name yet
      ast_peek(-1,  % Peek the field name now and use it to build the next (key,value) pair
               LAMBDA (token_item:TokenItem):
               ast_make(add_jobj(token_item))))

  JSONPeg : PEG =
    newPEG("JDoc")
      <| ( "JDoc"    <<= "JValue" + **(PegWhiteLines + "JValue") )
      <| ( "JValue"  <<= "JNum" / "JBool" / "JStr" / "JNull" / "JArray" / "JObject" )
      <| ( "JNum"    <<= PegToken(Float,"Number") o ast_new(str2jnum) )
      <| ( "JBool"   <<= (PegToken("true") / PegToken("false")) o mk_jbool )
      <| ( "JStr"    <<= PegToken(DQString,"String") o mk_str )
      <| ( "JNull"   <<= PegLiteral("null") o ast_this(JNull) )
      <| ( "JArray"  <<= PegLiteral("[") +
                         ([| "JValue" + **(PegLiteral(",") + "JValue") |]) o mk_jarray +
			 PegLiteral("]") )
      <| ( "JObject" <<= PegLiteral("{") +
                         ([| "JField" + **(PegLiteral(",") + "JField") |]) o mk_jobject +
			 PegLiteral("}") )
      <| ( "JField"  <<= PegToken(DQString,"Key") + PegLiteral(":") + "JValue" )

END JSONPeg
