% AST builder for PEGs
peg_ast[AST:TYPE] : THEORY
BEGIN

  IMPORTING peg,
            peg_def[AST],
	    structures@iterator

  NoAST : ASTOutput = OptAST(None)

  MkAST(ast:AST) : ASTOutput = OptAST(Some(ast))

  % ASTDeck is an iterator on the top (working) tier
  ASTDeck : TYPE = Iterator[Item]

  % Get Some(token_item) at n-th position of deck. Return None position is not
  % a TokenItem or if it n out of range
  get_token_at(deck:ASTDeck,n:nat) : Maybe[string] =
    IF n < length(deck) THEN
      LET item = deck(n) IN
      IF token_item?(item) THEN
	Some(get_token(item))
      ELSE
	None
      ENDIF
    ELSE
      None
    ENDIF

  % Get Some(ast_item) at n-th position of deck. Return None if position is not
  % an ASTitem or if n is out of range
  get_ast_at(deck:ASTDeck,n:nat) : Maybe[AST] =
    IF n < length(deck) THEN
      LET item = deck(n) IN
      IF ast_item?(item) THEN
	Some(get_ast(item))
      ELSE
	None
      ENDIF
    ELSE
      None
    ENDIF

  deck(state:PegState) : ASTDeck =
    LET fseq = IF null?(state`scaffold) THEN
                 empty_seq
	       ELSE
	         car(state`scaffold)`items
	       ENDIF IN
    mk_iterator(fseq)  

  ast_deck(f:[ASTDeck->ASTOutput])(state:PegState) : ASTOutput =
    f(deck(state))

  % Build AST from deck
  ;o(e:PEGex,f:[ASTDeck->ASTOutput]) : PEGex =
    PegAST(e,ast_deck(f))

  valid_next?(deck:ASTDeck)(next:nat) : bool =
    deck`next <= next <= deck`length

  ASTBuildFun : TYPE = [x:[Maybe[AST],ASTDeck]->[ASTOutput,(valid_next?(x`2))]]

  ASTBuilder : DATATYPE
  BEGIN
    ast_build(bld_fun:ASTBuildFun): ast_build?
    ast_seq(bld1,bld2:ASTBuilder) : ast_seq?
    ast_try(bld_try,bld_then,bld_else:ASTBuilder) : ast_try?
    ast_repeat(bld:ASTBuilder) : ast_repeat?
  END ASTBuilder

  IMPORTING orders@lex2_generic[ASTBuilder,nat]

  build(bld:ASTBuilder)(opt_ast:Maybe[AST],deck:ASTDeck) :
    RECURSIVE [ASTOutput,(valid_next?(deck))] =
    CASES bld OF
      ast_build(bld_fun) :
        bld_fun(opt_ast,deck),
      ast_seq(bld1,bld2) :
        LET seq_out = build(bld1)(opt_ast,deck),
            (ast_out,next) = seq_out IN
        IF exit?(ast_out) OR fail?(ast_out) THEN
          seq_out
        ELSE
          build(bld2)(get_opt_ast(ast_out),set_it(deck)(next))
        ENDIF,
      ast_try(try_bld,then_bld,else_bld) :
        LET try_out = build(try_bld)(opt_ast,deck),
            (ast_out,next) = try_out IN
        IF exit?(ast_out) OR fail?(ast_out) THEN
          try_out
        ELSIF next > next(deck) THEN
          build(then_bld)(get_opt_ast(ast_out),set_it(deck)(next))
        ELSE
          build(else_bld)(opt_ast,deck)
        ENDIF,
      ast_repeat(bld) :
        LET repeat_out = build(bld)(opt_ast,deck),
            (ast_out,next) = repeat_out IN
        IF exit?(ast_out) OR fail?(ast_out) THEN
          repeat_out
        ELSIF next > next(deck) THEN
          build(ast_repeat(bld))(get_opt_ast(ast_out),set_it(deck)(next))
        ELSE
          (OptAST(opt_ast),next(deck))
	ENDIF
     ENDCASES
     MEASURE (bld,(length(deck)-next(deck))::nat) BY lt_lex2(<<,lt_nat)

  % Build AST from ASTBuilder
  ;o(e:PEGex,bld:ASTBuilder) : PEGex =
    PegAST(e,ast_deck(LAMBDA(deck:ASTDeck):
      LET (ast_out,next) = build(bld)(None,mk_iterator(deck)) IN
      IF (exit?(ast_out) OR fail?(ast_out)) AND
         none?(get_opt_loc(ast_out)) AND next < length(deck) THEN
        IF exit?(ast_out) THEN
          Exit(get_msg(ast_out),get_loc(deck(next)))
	ELSE
	  Fail(get_label(ast_out),get_loc(deck(next)))
	ENDIF
      ELSE
        ast_out
      ENDIF))

  bld_skip(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    (OptAST(opt_ast),next(deck))

  % Do nothing
  ast_skip : ASTBuilder =
    ast_build(bld_skip)

  bld_consume(P:PRED[Item])(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    IF has_next?(deck) AND P(get_next(deck)) THEN
      (OptAST(opt_ast),next(deck)+1)
    ELSE
      (OptAST(opt_ast),next(deck))
    ENDIF

  ast_consume(P:PRED[Item]) : ASTBuilder =
    ast_build(bld_consume(P))

  ast_consume : ASTBuilder =
    ast_consume(LAMBDA(item:Item):TRUE)
    
  ast_consume(P:PRED[ASTItem]) : ASTBuilder =
    ast_consume(LAMBDA(item:Item):
      ast_item?(item) AND P(item))

   ast_consume(P:PRED[AST]) : ASTBuilder =
    ast_consume(LAMBDA(ast_item:ASTItem):P(get_ast(ast_item)))

  ast_consume(P:PRED[TokenItem]) : ASTBuilder =
    ast_consume(LAMBDA(item:Item):
      token_item?(item) AND P(item))

  % Consume next item if it is a TokenItem and satisfies predicate P
  % Do nothing otherwise
  ast_token(P:PRED[string]) : ASTBuilder =
    ast_consume(LAMBDA(token_item:TokenItem):P(get_token(token_item)))

  % Consume next item if it is a TokenItem and its token string is equal to literal
  % Do nothing otherwise
  ast_literal(literal:string) : ASTBuilder =
    ast_token(LAMBDA(str:string): str = literal)

  % Consume next item if it is a TokenItem and its token string is equal to literal
  % (modulo case insensitiveness)
  % Do nothing otherwise
  ast_LITERAL(literal:string) : ASTBuilder =
    ast_token(LAMBDA(str:string): strcompare(str,literal,FALSE) = 0)

  ;+(bld1,bld2:ASTBuilder) : ASTBuilder =
    ast_seq(bld1,bld2)

  % Try try_bld if it makes progress tries then_bld, otherwise do nothing
  ast_try(try_bld,then_bld:ASTBuilder) : ASTBuilder =
    ast_try(try_bld,then_bld,ast_skip)

  bld_peek(idx:int,bldf:[Item->ASTBuilder])(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    IF peekable?(deck)(idx) THEN
      build(bldf(peek(deck)(idx)))(opt_ast,deck)
    ELSE
      (OptAST(opt_ast),next(deck))
    ENDIF
  
  % Peek item at relative index idx and use it to make a new builder
  ast_peek(idx:int,bldf:[Item->ASTBuilder]) : ASTBuilder =
    ast_build(bld_peek(idx,bldf))

  % Peek item at relative index idx and if an ASTItem use it to make a new builder
  ast_peek(idx:int,bldf:[ASTItem->ASTBuilder]) : ASTBuilder =
    ast_peek(idx,LAMBDA(item:Item): IF ast_item?(item) THEN bldf(item) ELSE ast_skip ENDIF)

  % Peek item at relative index idx and if an ASTItem use its AST to make a new builder
  ast_peek(idx:int,bldf:[AST->ASTBuilder]) : ASTBuilder =
    ast_peek(idx,LAMBDA(ast_item:ASTItem): bldf(get_ast(ast_item)))

  % Peek item at relative index idx and if a TokenItem use it to make a new builder
  ast_peek(idx:int,bldf:[TokenItem->ASTBuilder]) : ASTBuilder =
    ast_peek(idx,LAMBDA(item:Item): IF token_item?(item) THEN bldf(item) ELSE ast_skip ENDIF)

  % Peek item at relative index idx and if a TokenItem use its token string to make a new builder
  ast_peek(idx:int,bldf:[string->ASTBuilder]) : ASTBuilder =
    ast_peek(idx,LAMBDA(token_item:TokenItem): bldf(get_token(token_item)))

  bld_exit(mssg:string)(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    (Exit(mssg),next(deck))

  ast_exit(mssg:string) : ASTBuilder =
    ast_build(bld_exit(mssg))

  bld_new(mk:[Item->ASTOutput])(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    IF has_next?(deck) THEN
      LET ast_out = mk(get_next(deck)) IN
      (ast_out,IF exit?(ast_out) OR fail?(ast_out) THEN
                 next(deck)
	       ELSE
	         next(deck)+1
	       ENDIF)
    ELSE
      (OptAST(opt_ast),next(deck))
    ENDIF

  % Ignore accumulated AST and make ASTOutput with next AST item
  % Do nothing if at the end of AST deck
  ast_new(mk:[Item->ASTOutput]) : ASTBuilder =
    ast_build(bld_new(mk))

  % Ignore accumulated AST and make ASTOutput with next AST item
  % Do nothing if next item is not an ASTItem
  ast_new(mk:[ASTItem->ASTOutput]) : ASTBuilder =
    ast_new(LAMBDA(item:Item) : IF ast_item?(item) THEN mk(item) ELSE NoAST ENDIF)

  % Ignore accumulated AST and make ASTOutput with next AST from next AST item
  % Do nothing if next item is not an ASTItem
  ast_new(mk:[AST->ASTOutput]) : ASTBuilder =
    ast_new(LAMBDA(ast_item:ASTItem) : mk(get_ast(ast_item)))

  % Ignore accumulated AST and make ASTOutput with next TokenItem
  % Do nothing if next item is not ASTItem
  ast_new(mk:[TokenItem->ASTOutput]) : ASTBuilder =
    ast_new(LAMBDA(item:Item) : IF token_item?(item) THEN mk(item) ELSE NoAST ENDIF)

  % Ignore accumulated AST and make ASTOutput with token string from next TokenItem
  % Do nothing if next item is not an ASTItem
  ast_new(mk:[string->ASTOutput]) : ASTBuilder =
    ast_new(LAMBDA(token_item:TokenItem):mk(get_token(token_item)))

  % Ignore accumulated AST and make ASTOutput with AST from next AST item
  % Do nothing if next item is not an ASTItem
  ast_self : ASTBuilder =
    ast_new(LAMBDA(item:ASTItem):MkAST(get_ast(item)))

  bld_this(ast:AST)(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    (MkAST(ast),next(deck))

  % Ignore accumulated AST and make ASTOutput with the provided AST
  ast_this(ast:AST) : ASTBuilder =
    ast_build(bld_this(ast))

  bld_make(mk:[[AST,Item]->ASTOutput])(opt_ast:Maybe[AST],deck:ASTDeck)
    : [ASTOutput,(valid_next?(deck))] =
    IF has_next?(deck) AND some?(opt_ast) THEN
      LET ast_out = mk(val(opt_ast),get_next(deck)) IN
      (ast_out,IF exit?(ast_out) OR fail?(ast_out) THEN
                 next(deck)
	       ELSE
	         next(deck)+1
	       ENDIF)
    ELSE
      (OptAST(opt_ast),next(deck))
    ENDIF

  % Make ASTOutput from accumulated AST and next Item
  ast_make(mk:[[AST,Item]->ASTOutput]) : ASTBuilder =
    ast_build(bld_make(mk))

  % Make ASTOutput from accumulated AST and next ASTItem
  % Do nothing if next item is not an ASTItem
  ast_make(mk:[[AST,ASTItem]->ASTOutput]) : ASTBuilder =
    ast_make(LAMBDA(ast:AST,item:Item):
      IF ast_item?(item) THEN mk(ast,item) ELSE NoAST ENDIF)

  % Make ASTOutput from accumulated AST and AST from next ASTItem
  % Do nothing if next item is not an ASTItem
  ast_make(mk:[[AST,AST]->ASTOutput]) : ASTBuilder =
    ast_make(LAMBDA(ast:AST,ast_item:ASTItem) : mk(ast,get_ast(ast_item)))

  % Make ASTOutput from accumulated AST and next TokenItem
  % Do nothing if next item is not a TokenItem
  ast_make(mk:[[AST,TokenItem]->ASTOutput]) : ASTBuilder =
    ast_make(LAMBDA(ast:AST,item:Item):
      IF token_item?(item) THEN mk(ast,item) ELSE NoAST ENDIF)

  % Make ASTOutput from accumulated AST and token string from next TokenItem
  % Do nothing if next item is not a TokenItem
  ast_make(mk:[[AST,string]->ASTOutput]) : ASTBuilder =
    ast_make(LAMBDA(ast:AST,token_item:TokenItem): mk(ast,get_token(token_item)))

  CONVERSION MkAST

END peg_ast
